# Скопируйте в .env.admin (файл в .gitignore). Нужен только скрипту npm run seed:users.
# service_role-ключ обходит все правила доступа: не добавляйте ему префикс VITE_
# и никогда не кладите его во фронтенд или в репозиторий.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Пароль демо-пользователей (по умолчанию crm-demo-2026)
DEMO_PASSWORD=crm-demo-2026
